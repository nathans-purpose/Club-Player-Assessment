# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project settings → API). For local development, use the
# values printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app, used to build sign-in redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in for the local Supabase stack (read by supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server-side only, used from step 5 (AI import). Never expose to the client.
ANTHROPIC_API_KEY=

# Optional: Postgres server for the RLS tests (each run creates and drops its
# own database). Defaults to postgres://postgres:postgres@localhost:5432/postgres
# TEST_DATABASE_URL=
